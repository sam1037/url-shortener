# Copy to .env.perf. Used by `npm run start:perf` for benchmarks.
# One-time: docker exec url-shortener-postgres-1 psql -U <user> -d <db> -c 'CREATE DATABASE shortener_perf'
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CODE_LENGTH=6
# own DB so seeded bench rows never land in dev data
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/shortener_perf
# db 2: separate from dev (0) and tests (1)
REDIS_URL=redis://localhost:6379/2
DEFAULT_TTL=86400
# high so the limiters never answer 429 mid-benchmark (that would fake fast latencies)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100000000
SHORTEN_RATE_LIMIT_WINDOW_MS=60000
SHORTEN_RATE_LIMIT_MAX=100000000
# don't set CACHE_ENABLED here; pass it on the command line so each run is explicit
