# Copy to .env.test. Tests TRUNCATE tables, so DATABASE_URL must point at a DB whose name ends in _test.
# One-time: docker exec url-shortener-postgres-1 psql -U <user> -d <db> -c 'CREATE DATABASE shortener_test'
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
CODE_LENGTH=6
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/shortener_test
# db 1 so tests flushing the cache never touch the dev cache in db 0
REDIS_URL=redis://localhost:6379/1
# high so the limiters don't trip the other tests; rateLimit.test.ts lowers its own
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100000
SHORTEN_RATE_LIMIT_WINDOW_MS=60000
SHORTEN_RATE_LIMIT_MAX=100000
